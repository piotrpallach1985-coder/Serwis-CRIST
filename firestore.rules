rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantUser(tenantId) {
      return isSignedIn() && (getUserData().tenantId == tenantId || (tenantId == 'crist' && !('tenantId' in getUserData())) || isSuperAdmin());
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'superadmin');
    }

    function isStaff() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'superadmin' || getUserData().role == 'kierownik' || getUserData().role == 'tech');
    }

    // Użytkownicy - tylko admin może zarządzać wszystkimi
    match /users/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Centralny rejestr firm (SaaS) - Tylko superadmin
    match /tenant_registry/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Reguły dla tenantów (Multi-Tenancy)
    match /tenants/{tenantId} {
      match /reporters/{document=**} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isTenantUser(tenantId);
      }

      match /machines/{document=**} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isTenantUser(tenantId);
      }

      match /tickets/{ticketId} {
        allow read: if isSignedIn();   
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isTenantUser(tenantId);
      }

      match /regions/{document=**} {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /topics/{document=**} {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /services/{document=**} {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /roles/{document=**} {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /notifications/{document=**} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isTenantUser(tenantId);
      }

      match /settings/{document=**} {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /planned_services/{document=**} {
        allow read: if isSignedIn();
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /action_items/{document=**} {
        allow read: if isSignedIn();
        allow write: if isTenantUser(tenantId) && isStaff();
      }
    }
  }
}