rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }
    
    function isActiveUser() {
      let data = getUserData();
      return data != null && (!('isDeleted' in data) || data.isDeleted == false);
    }

    function isTenantUser(tenantId) {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && (data.tenantId == tenantId || (tenantId == 'crist' && !('tenantId' in data)) || isSuperAdmin());
    }

    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && data.role == 'superadmin';
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && (data.role == 'admin' || data.role == 'superadmin');
    }

    function isStaff() {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && (data.role == 'admin' || data.role == 'superadmin' || data.role == 'kierownik' || data.role == 'manager' || data.role == 'tech' || (data.role != 'operator'));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isActiveUser() && (request.auth.uid == userId || isSuperAdmin() || getUserData().tenantId == resource.data.tenantId);
      allow write: if isAdmin() 
          && (resource == null || resource.data.tenantId == getUserData().tenantId || isSuperAdmin())
          && (request.resource.data.tenantId == getUserData().tenantId || isSuperAdmin()) 
          && (!('role' in request.resource.data) || request.resource.data.role != 'superadmin' || isSuperAdmin());
    }

    match /tenant_registry/_global_settings_ {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /tenant_registry/{document=**} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /tenant_api_keys/{keyId} {
      allow read: if isStaff() && (resource == null || isTenantUser(resource.data.tenantId));
      allow create: if isStaff() && isTenantUser(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['prefix', 'tenantId', 'name', 'active', 'createdAt']);
      allow delete: if isStaff() && isTenantUser(resource.data.tenantId);
      allow update: if false;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /tenants/{tenantId} {
      match /reporters/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow create: if isTenantUser(tenantId)
          || (isAnonymous()
              && request.resource.data.keys().hasOnly(['name', 'phone', 'createdAt'])
              && request.resource.data.name is string
              && request.resource.data.name.size() < 120
              && request.resource.data.name.matches('.*\\\\(DO WERYFIKACJI\\\\)$'));
        allow update, delete: if isTenantUser(tenantId);
      }

      match /machines/{document=**} {
        allow read: if isTenantUser(tenantId) || isAnonymous();
        allow create: if isTenantUser(tenantId)
          || (isAnonymous()
              && request.resource.data.keys().hasOnly(['name', 'regionId', 'bay', 'currentWorkHours', 'status', 'isDeleted', 'createdAt', 'createdBy', 'description'])
              && request.resource.data.name is string
              && request.resource.data.name.size() < 200
              && request.resource.data.name.matches('.*\\\\(DO WERYFIKACJI\\\\)$')
              && request.resource.data.isDeleted == false);
        allow update, delete: if isTenantUser(tenantId);
      }

      match /tickets/{ticketId} {
        allow read, update, delete: if isTenantUser(tenantId);
        // Anonim musi podać machineId które rzeczywiście istnieje w tym tenancie, lub 'manual'
        allow create: if isTenantUser(tenantId) || 
          (isAnonymous() && (
             (request.resource.data.machineId == 'manual' && exists(/databases/$(database)/documents/tenants/$(tenantId))) ||
             exists(/databases/$(database)/documents/tenants/$(tenantId)/machines/$(request.resource.data.machineId))
          ));
      }

      match /regions/{document=**} {
        allow read: if isTenantUser(tenantId) || isAnonymous();
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /topics/{document=**} {
        allow read: if isTenantUser(tenantId) || isAnonymous();
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /services/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /roles/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /notifications/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow create: if isTenantUser(tenantId)
          || (isAnonymous()
              && request.resource.data.keys().hasOnly(['title', 'message', 'isCritical', 'read', 'ticketId', 'createdAt', 'type'])
              && request.resource.data.read == false
              && request.resource.data.ticketId is string);
        allow update, delete: if isTenantUser(tenantId);
      }

      match /settings/branding {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /settings/general {
        allow read: if true;
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /settings/{document=**} {
        allow read: if isTenantUser(tenantId); 
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /stats/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow write: if isSuperAdmin();
      }
      
      match /planned_services/{document=**} {
        allow read, write: if isTenantUser(tenantId);
      }
      
      match /parts/{document=**} {
        allow read, write: if isTenantUser(tenantId);
      }

      match /part_transactions/{document=**} {
        allow read, write: if isTenantUser(tenantId);
      }
      match /action_items/{document=**} {
        allow read, write: if isTenantUser(tenantId);
      }

      match /audit_logs/{document=**} {
        allow create: if isTenantUser(tenantId);
        allow read: if isTenantUser(tenantId) && isStaff();
        allow update, delete: if isSuperAdmin();
      }

      match /crash_reports/{document=**} {
        allow create: if isTenantUser(tenantId);
        allow read, update, delete: if isTenantUser(tenantId) && isAdmin();
      }
    }
  }
}

