rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }
    
    function isActiveUser() {
      let data = getUserData();
      return data != null && (!('isDeleted' in data) || data.isDeleted == false);
    }

    function isTenantActive(tenantId) {
      let genPath = /databases/$(database)/documents/tenants/$(tenantId)/settings/general;
      return !exists(genPath) || get(genPath).data.get('status', 'active') != 'suspended';
    }

    function isTenantUser(tenantId) {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && (isSuperAdmin() || (isTenantActive(tenantId) && (data.tenantId == tenantId || (tenantId == 'crist' && !('tenantId' in data)))));
    }

    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && data.role == 'superadmin';
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && (data.role == 'admin' || data.role == 'superadmin');
    }

    function isStaff() {
      let data = getUserData();
      return isSignedIn() && isActiveUser() && ('role' in data) && (data.role is string) && data.role.size() > 0 && data.role != 'operator';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isActiveUser() && (request.auth.uid == userId || isSuperAdmin() || getUserData().tenantId == resource.data.tenantId);
      allow write: if isAdmin() 
          && (resource == null || resource.data.tenantId == getUserData().tenantId || isSuperAdmin())
          && (resource == null || !('role' in resource.data) || resource.data.role != 'superadmin' || isSuperAdmin())
          && (request.resource.data.tenantId == getUserData().tenantId || isSuperAdmin()) 
          && (!('role' in request.resource.data) || request.resource.data.role != 'superadmin' || isSuperAdmin());
    }

    match /tenant_registry/_global_settings_ {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /tenant_registry/{document=**} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /tenant_api_keys/{keyId} {
      allow read: if isAdmin() && (resource == null || isTenantUser(resource.data.tenantId));
      allow create: if isAdmin() && isTenantUser(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['prefix', 'tenantId', 'name', 'active', 'createdAt']);
      allow delete: if isAdmin() && isTenantUser(resource.data.tenantId);
      allow update: if false;
    }

    // ===== Operatorzy QR (sesje anonimowe) =====
    // Sesję można powiązać z firmą TYLKO znając klucz QR tej firmy (tenants/{t}/settings/qr_access).
    // Zmiana klucza przez admina unieważnia wszystkie istniejące sesje QR i stare naklejki.
    match /anon_sessions/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAnonymous() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['tenantId', 'qrKey', 'createdAt'])
        && request.resource.data.tenantId is string
        && request.resource.data.qrKey is string
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)/settings/qr_access)
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)/settings/qr_access).data.key == request.resource.data.qrKey;
      allow update, delete: if isSuperAdmin();
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function anonSessionValid(tenantId) {
      let sessionPath = /databases/$(database)/documents/anon_sessions/$(request.auth.uid);
      let keyPath = /databases/$(database)/documents/tenants/$(tenantId)/settings/qr_access;
      return isTenantActive(tenantId)
        && exists(sessionPath)
        && get(sessionPath).data.tenantId == tenantId
        && exists(keyPath)
        && get(sessionPath).data.get('qrKey', '') == get(keyPath).data.key;
    }

    function isAnonymousInTenant(tenantId) {
      return isAnonymous() && anonSessionValid(tenantId);
    }

    // Zdjęcie zgłoszenia musi pochodzić z katalogu TEGO zgłoszenia w Storage tej firmy
    function isTicketPhotoUrl(url, tenantId, ticketId) {
      return url is string && url.size() < 2000
        && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/tenants%2F' + tenantId + '%2Ftickets%2F' + ticketId + '%2F[^?]+([?].*)?');
    }

    function photoOk(list, i, tenantId, ticketId) {
      return list.size() <= i || isTicketPhotoUrl(list[i], tenantId, ticketId);
    }

    function photosValid(list, tenantId, ticketId) {
      return list.size() <= 10
        && photoOk(list, 0, tenantId, ticketId) && photoOk(list, 1, tenantId, ticketId)
        && photoOk(list, 2, tenantId, ticketId) && photoOk(list, 3, tenantId, ticketId)
        && photoOk(list, 4, tenantId, ticketId) && photoOk(list, 5, tenantId, ticketId)
        && photoOk(list, 6, tenantId, ticketId) && photoOk(list, 7, tenantId, ticketId)
        && photoOk(list, 8, tenantId, ticketId) && photoOk(list, 9, tenantId, ticketId);
    }

    function optString(d, field, maxLen) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= maxLen);
    }

    function isIndustrialTenant(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/settings/branding)
        && get(/databases/$(database)/documents/tenants/$(tenantId)/settings/branding).data.get('industryProfile', 'industrial') == 'industrial';
    }

    // PIN Mapy Głównej (settings/map.reportPin lub settings/branding.mainMapReportPin) – zgodnie z resolveRegionReportPin()
    function mainMapPinOk(tenantId, d) {
      let mapPath = /databases/$(database)/documents/tenants/$(tenantId)/settings/map;
      let brandPath = /databases/$(database)/documents/tenants/$(tenantId)/settings/branding;
      let mapPin = exists(mapPath) ? get(mapPath).data.get('reportPin', '') : '';
      let brandPin = exists(brandPath) ? get(brandPath).data.get('mainMapReportPin', '') : '';
      let pin = (mapPin is string && mapPin.size() > 0) ? mapPin : brandPin;
      return !(pin is string) || pin.size() == 0 || ('reportPin' in d && d.reportPin == pin);
    }

    function parentRegionPinOk(tenantId, parentId, d) {
      let pPath = /databases/$(database)/documents/tenants/$(tenantId)/regions/$(parentId);
      return (exists(pPath) && get(pPath).data.get('reportPin', '') is string
          && get(pPath).data.get('reportPin', '').size() > 0)
        ? ('reportPin' in d && d.reportPin == get(pPath).data.reportPin)
        : mainMapPinOk(tenantId, d);
    }

    function anonPinMatchesRegionId(tenantId, regionId, d) {
      let rDoc = get(/databases/$(database)/documents/tenants/$(tenantId)/regions/$(regionId)).data;
      let parentId = rDoc.get('parentId', '');
      return (rDoc.get('reportPin', '') is string && rDoc.get('reportPin', '').size() > 0)
        ? ('reportPin' in d && d.reportPin == rDoc.reportPin)
        : ((parentId is string && parentId.size() > 0)
            ? parentRegionPinOk(tenantId, parentId, d)
            : mainMapPinOk(tenantId, d));
    }

    // Rejon dla urządzenia brany jest WYŁĄCZNIE z dokumentu urządzenia (zgłaszający nie może podmienić regionId)
    function anonRegionPinOk(tenantId, regionId, d) {
      return (!(regionId is string) || regionId == '' || regionId == 'main_map'
          || !exists(/databases/$(database)/documents/tenants/$(tenantId)/regions/$(regionId)))
        ? mainMapPinOk(tenantId, d)
        : anonPinMatchesRegionId(tenantId, regionId, d);
    }

    function anonTicketPinValid(tenantId, d) {
      let mPath = /databases/$(database)/documents/tenants/$(tenantId)/machines/$(d.machineId);
      return isIndustrialTenant(tenantId)
        || (d.machineId != 'manual'
          ? (
              get(mPath).data.get('assetCategory', 'device') == 'vehicle'
              || (
                  (get(mPath).data.get('reportPin', '') is string && get(mPath).data.get('reportPin', '').size() > 0)
                    ? ('reportPin' in d && d.reportPin == get(mPath).data.reportPin)
                    : anonRegionPinOk(tenantId, get(mPath).data.get('regionId', ''), d)
                 )
            )
          : anonRegionPinOk(tenantId, d.get('regionId', ''), d));
    }

    // Zgłoszenie anonima: tylko pola formularza, status "Nowe" (1), bez przypisań/zamknięć/kosztów
    function isValidAnonTicket(tenantId, ticketId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['machineId', 'machineName', 'bay', 'regionId', 'regionName', 'topic', 'description',
                               'isCritical', 'reportedBy', 'reporterPhone', 'reporterDevice', 'reporterDeviceId',
                               'reporterUid', 'status', 'createdAt', 'photos', 'updates', 'reportPin',
                               'vehicleGps', 'reportedWorkHours'])
        && d.keys().hasAll(['machineId', 'topic', 'description', 'status', 'reporterUid'])
        && d.status == 1
        && d.reporterUid == request.auth.uid
        && d.machineId is string
        && (d.machineId == 'manual' || exists(/databases/$(database)/documents/tenants/$(tenantId)/machines/$(d.machineId)))
        && anonTicketPinValid(tenantId, d)
        && d.topic is string && d.topic.size() > 0 && d.topic.size() <= 300
        && d.description is string && d.description.size() > 0 && d.description.size() <= 5000
        && optString(d, 'machineName', 300)
        && optString(d, 'bay', 100)
        && optString(d, 'regionId', 100)
        && optString(d, 'regionName', 200)
        && optString(d, 'reportedBy', 120)
        && optString(d, 'reporterPhone', 20)
        && optString(d, 'reporterDevice', 500)
        && optString(d, 'reporterDeviceId', 200)
        && optString(d, 'createdAt', 40)
        && optString(d, 'reportPin', 30)
        && (!('isCritical' in d) || d.isCritical is bool)
        && (!('reportedWorkHours' in d) || (d.reportedWorkHours is number && d.reportedWorkHours >= 0))
        && (!('vehicleGps' in d) || (d.vehicleGps is map && d.vehicleGps.keys().hasOnly(['lat', 'lng', 'accuracy', 'timestamp'])
              && d.vehicleGps.lat is number && d.vehicleGps.lng is number))
        && (!('photos' in d) || (d.photos is list && photosValid(d.photos, tenantId, ticketId)))
        && (!('updates' in d) || (d.updates is list && d.updates.size() <= 1
              && (d.updates.size() == 0 || (d.updates[0].status == 1 && d.updates[0].keys().hasOnly(['timestamp', 'status', 'comment', 'author'])))));
    }

    match /tenants/{tenantId} {
      match /reporters/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow create: if isTenantUser(tenantId)
          || (isAnonymousInTenant(tenantId)
              && request.resource.data.keys().hasOnly(['name', 'phone', 'createdAt'])
              && request.resource.data.name is string
              && request.resource.data.name.size() < 120
              && request.resource.data.name.matches('.*[(]DO WERYFIKACJI[)]$'));
        allow update, delete: if isTenantUser(tenantId);
      }

      match /machines/{document=**} {
        allow get: if isTenantUser(tenantId) || isAnonymousInTenant(tenantId);
        allow list: if isTenantUser(tenantId) || (isAnonymousInTenant(tenantId) && request.query.limit <= 1);
        allow create: if isTenantUser(tenantId)
          || (isAnonymousInTenant(tenantId)
              && request.resource.data.keys().hasOnly(['name', 'regionId', 'bay', 'currentWorkHours', 'status', 'isDeleted', 'createdAt', 'createdBy', 'description'])
              && request.resource.data.name is string
              && request.resource.data.name.size() < 200
              && request.resource.data.name.matches('.*[(]DO WERYFIKACJI[)]$')
              && request.resource.data.isDeleted == false);
        allow update: if isTenantUser(tenantId)
          || (isAnonymousInTenant(tenantId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentWorkHours', 'lastWorkHoursUpdate', 'workHoursHistory'])
              && request.resource.data.currentWorkHours is number
              && request.resource.data.currentWorkHours >= resource.data.get('currentWorkHours', 0)
              && request.resource.data.currentWorkHours <= 10000000);
        allow delete: if isTenantUser(tenantId) && isAdmin();
      }

      match /tickets/{ticketId} {
        allow read, update: if isTenantUser(tenantId);
        allow delete: if isTenantUser(tenantId) && isAdmin();
        allow create: if isTenantUser(tenantId)
          || (isAnonymousInTenant(tenantId) && isValidAnonTicket(tenantId, ticketId));
        // Anonim: dopięcie JEDNEGO zdjęcia do WŁASNEGO zgłoszenia (synchronizacja offline, arrayUnion)
        allow update: if isAnonymousInTenant(tenantId)
          && resource.data.get('reporterUid', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos'])
          && request.resource.data.photos is list
          && request.resource.data.photos.size() == resource.data.get('photos', []).size() + 1
          && request.resource.data.photos.size() <= 10
          && request.resource.data.photos.hasAll(resource.data.get('photos', []))
          && request.resource.data.photos.removeAll(resource.data.get('photos', [])).size() == 1
          && isTicketPhotoUrl(request.resource.data.photos.removeAll(resource.data.get('photos', []))[0], tenantId, ticketId);
      }

      match /regions/{document=**} {
        allow read: if isTenantUser(tenantId) || isAnonymousInTenant(tenantId);
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /topics/{document=**} {
        allow read: if isTenantUser(tenantId) || isAnonymousInTenant(tenantId);
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /services/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isStaff();
      }
      
      match /roles/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /notifications/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow create: if isTenantUser(tenantId)
          || (isAnonymousInTenant(tenantId)
              && request.resource.data.keys().hasOnly(['title', 'message', 'isCritical', 'read', 'ticketId', 'createdAt', 'type'])
              && request.resource.data.read == false
              && request.resource.data.ticketId is string
              && request.resource.data.title is string && request.resource.data.title.size() <= 200
              && request.resource.data.message is string && request.resource.data.message.size() <= 1000);
        allow update, delete: if isTenantUser(tenantId);
      }

      match /settings/branding {
        allow read: if true;
        allow write: if isSuperAdmin()
          || (isTenantUser(tenantId) && isAdmin()
              && (resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['limits', 'modules', 'status'])));
      }

      match /settings/general {
        allow read: if true;
        allow write: if isSuperAdmin()
          || (isTenantUser(tenantId) && isAdmin()
              && (resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['limits', 'modules', 'status'])));
      }

      // Klucz QR firmy: odczyt dla personelu (generowanie naklejek), utworzenie przez personel (gdy brak),
      // zmiana (unieważnienie wszystkich kodów i sesji QR) tylko przez admina. Anonim nie ma odczytu.
      match /settings/qr_access {
        allow read: if isTenantUser(tenantId) && isStaff();
        allow create: if isTenantUser(tenantId) && isStaff()
          && request.resource.data.keys().hasOnly(['key', 'createdAt'])
          && request.resource.data.key is string
          && request.resource.data.key.size() >= 20;
        allow update: if isTenantUser(tenantId) && isAdmin()
          && request.resource.data.keys().hasOnly(['key', 'createdAt'])
          && request.resource.data.key is string
          && request.resource.data.key.size() >= 20;
      }

      match /settings/map {
        allow read: if isTenantUser(tenantId) || isAnonymousInTenant(tenantId);
        allow write: if isTenantUser(tenantId) && isStaff();
      }

      match /settings/{document=**} {
        allow read: if isTenantUser(tenantId); 
        allow write: if isTenantUser(tenantId) && isAdmin();
      }

      match /stats/{document=**} {
        allow read: if isTenantUser(tenantId);
        allow write: if isSuperAdmin();
      }
      
      match /planned_services/{document=**} {
        allow read, create, update: if isTenantUser(tenantId);
        allow delete: if isTenantUser(tenantId) && isAdmin();
      }
      
      match /parts/{document=**} {
        allow get: if isAnonymousInTenant(tenantId);
        allow read, create, update: if isTenantUser(tenantId);
        allow delete: if isTenantUser(tenantId) && isAdmin();
      }

      match /part_transactions/{document=**} {
        allow read, create: if isTenantUser(tenantId);
        allow update: if false;
        allow delete: if isSuperAdmin();
      }
      match /action_items/{document=**} {
        allow read, create, update: if isTenantUser(tenantId);
        allow delete: if isTenantUser(tenantId) && isAdmin();
      }

      match /audit_logs/{document=**} {
        allow create: if isTenantUser(tenantId)
          || (isAnonymousInTenant(tenantId)
              && request.resource.data.keys().hasOnly(['timestamp', 'userId', 'userName', 'action', 'entityType', 'entityId', 'details'])
              && request.resource.data.details is string
              && request.resource.data.details.size() <= 1000);
        allow read: if isTenantUser(tenantId) && isStaff();
        allow update: if false;
        allow delete: if isSuperAdmin();
      }

      match /crash_reports/{document=**} {
        allow create: if isTenantUser(tenantId);
        allow read, update, delete: if isTenantUser(tenantId) && isAdmin();
      }
    }
  }
}
