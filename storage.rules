rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function getTenant() {
      return getUserData().tenantId;
    }

    function isValidSize() {
      return request.resource.size < 30 * 1024 * 1024;
    }

    function isValidType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    match /tickets/{ticketId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSize() && isValidType() && 
                   firestore.exists(/databases/(default)/documents/tenants/$(getTenant())/tickets/$(ticketId));
    }

    match /machine_photos/{machineId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSize() && isValidType() && 
                   firestore.exists(/databases/(default)/documents/tenants/$(getTenant())/machines/$(machineId));
    }

    match /dtr_documents/{machineId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSize() && 
                   firestore.exists(/databases/(default)/documents/tenants/$(getTenant())/machines/$(machineId));
    }
    
    match /planned_services/{srvId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSize() && 
                   firestore.exists(/databases/(default)/documents/tenants/$(getTenant())/planned_services/$(srvId));
    }
    
    match /checklists/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidSize();
    }
    
    match /map_backgrounds/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /regions_maps/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && isValidSize() && isValidType();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
