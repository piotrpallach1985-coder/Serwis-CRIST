rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data : null;
    }

    function getTenant() {
      let data = getUserData();
      return data != null ? data.tenantId : null;
    }
    
    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'superadmin';
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Sesja QR musi wskazywać firmę i aktualny klucz QR firmy (2 unikalne dokumenty – limit Storage)
    function anonSessionValid(tenantId) {
      let s = firestore.get(/databases/(default)/documents/anon_sessions/$(request.auth.uid));
      let k = firestore.get(/databases/(default)/documents/tenants/$(tenantId)/settings/qr_access);
      return s != null && k != null
        && s.data.tenantId == tenantId
        && s.data.get('qrKey', '') == k.data.key;
    }

    function isAnonymousInTenant(tenantId) {
      return isAnonymous() && anonSessionValid(tenantId);
    }

    function isTenantUser(tenantId) {
       // !isAnonymous() – anonim nie czyta users/{uid} (limit 2 dokumentów Firestore na ocenę reguł Storage)
       return isSignedIn() && !isAnonymous() && (getTenant() == tenantId || isSuperAdmin());
    }

    function isValidSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    function isValidContentType() {
      return request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf');
    }

    function isLegacyAllowed() {
      return isSignedIn() && !isAnonymous() && (isSuperAdmin() || getTenant() == 'crist' || getTenant() == 'default');
    }

    match /tenants/{tenantId}/{allPaths=**} {
       allow read, delete: if isTenantUser(tenantId);
       allow create, update: if isTenantUser(tenantId) && isValidSize() && isValidContentType();
    }
    
    // Zgloszenia anonimowe (kody QR)
    match /tenants/{tenantId}/tickets/{ticketId}/{fileName} {
       // allow get zamiast read (read = get + list). Anonim nie moze listowac plikow.
       allow get: if isAnonymousInTenant(tenantId);
       allow create: if isAnonymousInTenant(tenantId) && isValidSize() && isValidContentType();
       allow update, delete: if false;
    }

    match /tickets/{ticketId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false; 
    }

    match /machine_photos/{machineId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }

    match /dtr_documents/{machineId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /planned_services/{srvId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /checklists/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /map_backgrounds/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /regions_maps/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }

    match /branding/{fileName} {
      allow read: if true;
      allow delete: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidSize();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
