rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data : null;
    }

    function getTenant() {
      let data = getUserData();
      return data != null ? data.tenantId : null;
    }
    
    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'superadmin';
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTenantUser(tenantId) {
       return isSignedIn() && (getTenant() == tenantId || isSuperAdmin());
    }

    function isValidSize() {
      return request.resource.size < 30 * 1024 * 1024;
    }

    function isValidContentType() {
      return request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf');
    }

    function isLegacyAllowed() {
      return isSignedIn() && !isAnonymous() && (isSuperAdmin() || getTenant() == 'crist' || getTenant() == 'default');
    }

    match /tenants/{tenantId}/{allPaths=**} {
       allow read, delete: if isTenantUser(tenantId);
       allow create, update: if isTenantUser(tenantId) && isValidSize() && isValidContentType();
    }
    
    // Zgloszenia anonimowe (kody QR)
    match /tenants/{tenantId}/tickets/{ticketId}/{fileName} {
       // allow get zamiast read (read = get + list). Anonim nie moze listowac plikow.
       allow get: if isAnonymous();
       allow create: if isAnonymous() && isValidSize() && isValidContentType();
       allow update, delete: if false;
    }

    match /tickets/{ticketId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false; 
    }

    match /machine_photos/{machineId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }

    match /dtr_documents/{machineId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /planned_services/{srvId}/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /checklists/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /map_backgrounds/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }
    
    match /regions_maps/{fileName} {
      allow read: if isLegacyAllowed();
      allow write: if false;
    }

    match /branding/{fileName} {
      allow read: if true;
      allow delete: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidSize();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

